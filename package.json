{
  "name": "poostikal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.9.8"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix backend run build && cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:web": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 7777",
    "dev:api": "npm --prefix backend run dev",
    "db:start": "npm --prefix backend run db:start",
    "test:backend": "npm --prefix backend test",
    "db:backup": "npm --prefix backend run backup"
  },
  "dependencies": {
    "@poostikal/rich-text": "file:packages/rich-text",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "cross-env": "10.1.0",
    "http-proxy-3": "2.0.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
