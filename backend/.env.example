PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:7777
DATABASE_URL=postgresql://poostikal:CHANGE_ME@127.0.0.1:55432/poostikal
DB_POOL_MAX=20
# Development defaults to a loopback-only broker. In production use a private Redis endpoint.
REDIS_URL=redis://127.0.0.1:56379
# Set a distinct value for each deployment when sharing a Redis broker.
REDIS_NAMESPACE=poostikal
MEDIA_DIR=../.data/media
ADMIN_EMAIL=admin@poostikal.local
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
AI_ENABLED=false
AI_DAILY_REQUEST_LIMIT=1000
NODE_ENV=development

# Set a random 32-byte secret for SMS login codes. Enter SMS.ir credentials in the admin panel.
OTP_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET
# Only set this behind a trusted proxy that overwrites forwarded IP headers
TRUST_PROXY=

# Optional Raboteb WooCommerce READ connection for catalog, stock and price pulls.
RABOTEB_CONSUMER_KEY=
RABOTEB_CONSUMER_SECRET=
# Set only after installing the stock bridge on Raboteb. Use the same random 64-hex-character
# secret as the POOSTIKAL_STOCK_BRIDGE_SECRET WordPress constant. Keep it server-side.
RABOTEB_STOCK_BRIDGE_SECRET=
# Required for encrypting SMS.ir and other service credentials saved through the admin panel.
# Generate once with: node scripts/setup-supplier-key.mjs
# Keep this value when moving the database to a VPS; do not commit or regenerate it.
SUPPLIER_ENCRYPTION_KEY=
# Optional outgoing HTTP proxy for this supplier only. Leave empty on a server with direct access.
RABOTEB_PROXY_URL=
