{
  "name": "poostikal-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "dev": "npm run build && npm start",
    "db:start": "node scripts/database.mjs",
    "test": "node --env-file=.env --test test/*.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.1",
    "@nestjs/core": "12.4.1",
    "@nestjs/platform-express": "12.4.1",
    "@poostikal/rich-text": "file:../packages/rich-text",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "music-metadata": "12.3.5",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "7.0.2"
  },
  "type": "module"
}
